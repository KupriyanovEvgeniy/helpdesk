<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="helpdesk">
        <createTable tableName="REPAIR_REQUEST_HISTORY">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_REPAIR_REQUEST_HISTORY"/>
            </column>
            <column name="USER_ID" type="UUID"/>
            <column name="DESCRIPTION" type="VARCHAR(1000)"/>
            <column name="COMPLETION_DATE" type="DATE"/>
            <column name="LOCATION_ID" type="UUID"/>
            <column name="ROOM_ID" type="UUID"/>
            <column name="EQUIPMENT_TYPE" type="VARCHAR(255)"/>
            <column name="EQUIPMENT_ID" type="UUID"/>
            <column name="FAULT_TYPE_ID" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_HISTORY_EQUIPMENT" tableName="REPAIR_REQUEST_HISTORY">
            <column name="EQUIPMENT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="EQUIPMENT_ID" baseTableName="REPAIR_REQUEST_HISTORY"
                                 constraintName="FK_REPAIR_REQUEST_HISTORY_ON_EQUIPMENT" referencedColumnNames="ID"
                                 referencedTableName="EQUIPMENT"/>
    </changeSet>
    <changeSet id="3" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_HISTORY_FAULT_TYPE" tableName="REPAIR_REQUEST_HISTORY">
            <column name="FAULT_TYPE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="FAULT_TYPE_ID" baseTableName="REPAIR_REQUEST_HISTORY"
                                 constraintName="FK_REPAIR_REQUEST_HISTORY_ON_FAULT_TYPE" referencedColumnNames="ID"
                                 referencedTableName="FAULT_TYPE"/>
    </changeSet>
    <changeSet id="4" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_HISTORY_LOCATION" tableName="REPAIR_REQUEST_HISTORY">
            <column name="LOCATION_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="LOCATION_ID" baseTableName="REPAIR_REQUEST_HISTORY"
                                 constraintName="FK_REPAIR_REQUEST_HISTORY_ON_LOCATION" referencedColumnNames="ID"
                                 referencedTableName="LOCATION"/>
    </changeSet>
    <changeSet id="5" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_HISTORY_ROOM" tableName="REPAIR_REQUEST_HISTORY">
            <column name="ROOM_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="ROOM_ID" baseTableName="REPAIR_REQUEST_HISTORY"
                                 constraintName="FK_REPAIR_REQUEST_HISTORY_ON_ROOM" referencedColumnNames="ID"
                                 referencedTableName="ROOM"/>
    </changeSet>
    <changeSet id="6" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_HISTORY_USER" tableName="REPAIR_REQUEST_HISTORY">
            <column name="USER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="REPAIR_REQUEST_HISTORY"
                                 constraintName="FK_REPAIR_REQUEST_HISTORY_ON_USER" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
</databaseChangeLog>