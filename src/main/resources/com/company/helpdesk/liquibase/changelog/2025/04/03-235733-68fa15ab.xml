<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="helpdesk">
        <addColumn tableName="REPAIR_REQUEST_HISTORY">
            <column name="AUDIO_FILE" type="VARCHAR(255)"/>
            <column name="IS_DRAFT" type="BOOLEAN"/>
            <column name="PHONE_NUMBER" type="VARCHAR(255)"/>
            <column name="PRIORITY" type="INT"/>
            <column name="RECOGNIZED_BY_AI" type="BOOLEAN"/>
            <column name="TASK_STATUS" type="VARCHAR(255)"/>
            <column name="USER_SUPPORT_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="helpdesk">
        <addColumn tableName="REPAIR_REQUEST_EQUIPMENT">
            <column name="REPAIR_REQUEST_HISTORY_ID" type="UUID"/>
        </addColumn>

        <addNotNullConstraint columnName="REPAIR_REQUEST_HISTORY_ID" tableName="REPAIR_REQUEST_EQUIPMENT"/>
    </changeSet>
    <changeSet id="3" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_EQUIPMENT_REPAIR_REQUEST_HISTORY"
                     tableName="REPAIR_REQUEST_EQUIPMENT">
            <column name="REPAIR_REQUEST_HISTORY_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="REPAIR_REQUEST_HISTORY_ID" baseTableName="REPAIR_REQUEST_EQUIPMENT"
                                 constraintName="FK_REPAIR_REQUEST_EQUIPMENT_ON_REPAIR_REQUEST_HISTORY"
                                 onDelete="CASCADE" referencedColumnNames="ID"
                                 referencedTableName="REPAIR_REQUEST_HISTORY"/>
    </changeSet>
    <changeSet id="4" author="helpdesk">
        <createIndex indexName="IDX_REPAIR_REQUEST_HISTORY_USER_SUPPORT" tableName="REPAIR_REQUEST_HISTORY">
            <column name="USER_SUPPORT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="USER_SUPPORT_ID" baseTableName="REPAIR_REQUEST_HISTORY"
                                 constraintName="FK_REPAIR_REQUEST_HISTORY_ON_USER_SUPPORT" referencedColumnNames="ID"
                                 referencedTableName="USER_"/>
    </changeSet>
</databaseChangeLog>